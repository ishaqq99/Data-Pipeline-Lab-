-- =====================================================================================
-- ONE-TIME ENVIRONMENT BOOTSTRAP for ${ENV} — run by a human as ACCOUNTADMIN.
-- Generated from env.sql.tmpl by render.py. Edit the template, not this file.
--
-- Creates the parts that must NEVER change on a normal merge:
--   database, the three schemas, roles, service users, grants.
-- After this, the pipeline (role VULN_DEPLOYER_${ENV}) can create/alter tables, views and
-- procedures INSIDE the schemas, but cannot create/drop databases, schemas, roles,
-- users, warehouses or integrations, and cannot change grants (managed-access schemas).
-- =====================================================================================

-- ---------- 1. Roles ----------
USE ROLE SECURITYADMIN;
CREATE ROLE IF NOT EXISTS VULN_DEPLOYER_${ENV} COMMENT = 'CI/CD (schemachange): owns tables/views/procs';
CREATE ROLE IF NOT EXISTS VULN_LOADER_${ENV}   COMMENT = 'ADF: loads RAW, runs CURATED procedures';
CREATE ROLE IF NOT EXISTS VULN_REPORTER_${ENV} COMMENT = 'Tableau / consumers: read BYOD_INFOSEC only';
GRANT ROLE VULN_DEPLOYER_${ENV} TO ROLE SYSADMIN;
GRANT ROLE VULN_LOADER_${ENV}   TO ROLE SYSADMIN;
GRANT ROLE VULN_REPORTER_${ENV} TO ROLE SYSADMIN;

-- ---------- 2. Database and schemas (managed access = only schema owner sets grants) ----------
USE ROLE SYSADMIN;
CREATE DATABASE IF NOT EXISTS VULN_MGMT_${ENV} COMMENT = 'Data-Pipeline-Lab ${ENV}';
CREATE SCHEMA IF NOT EXISTS VULN_MGMT_${ENV}.RAW_VULN_MANAGEMENT     WITH MANAGED ACCESS
  COMMENT = 'Raw tool payloads: one VARIANT per record + load metadata';
CREATE SCHEMA IF NOT EXISTS VULN_MGMT_${ENV}.CURATED_VULN_MANAGEMENT WITH MANAGED ACCESS
  COMMENT = 'Typed, deduplicated tables built by procedures from RAW';
CREATE SCHEMA IF NOT EXISTS VULN_MGMT_${ENV}.BYOD_INFOSEC            WITH MANAGED ACCESS
  COMMENT = 'Published contract for InfoSec reporting and downstream consumers (Tableau)';
CREATE SCHEMA IF NOT EXISTS VULN_MGMT_${ENV}.SCHEMACHANGE            WITH MANAGED ACCESS
  COMMENT = 'schemachange deployment history';
DROP SCHEMA IF EXISTS VULN_MGMT_${ENV}.PUBLIC;

-- ---------- 3. Warehouse + database usage ----------
GRANT USAGE ON WAREHOUSE VULN_WH TO ROLE VULN_DEPLOYER_${ENV};
GRANT USAGE ON WAREHOUSE VULN_WH TO ROLE VULN_LOADER_${ENV};
GRANT USAGE ON WAREHOUSE VULN_WH TO ROLE VULN_REPORTER_${ENV};
GRANT USAGE ON DATABASE VULN_MGMT_${ENV} TO ROLE VULN_DEPLOYER_${ENV};
GRANT USAGE ON DATABASE VULN_MGMT_${ENV} TO ROLE VULN_LOADER_${ENV};
GRANT USAGE ON DATABASE VULN_MGMT_${ENV} TO ROLE VULN_REPORTER_${ENV};

-- ---------- 4. Deployer: may create objects inside the schemas, nothing above them ----------
USE ROLE SECURITYADMIN;
GRANT USAGE, CREATE TABLE, CREATE VIEW, CREATE PROCEDURE, CREATE FUNCTION, CREATE SEQUENCE,
      CREATE STAGE, CREATE FILE FORMAT, CREATE STREAM, CREATE TASK
  ON SCHEMA VULN_MGMT_${ENV}.RAW_VULN_MANAGEMENT     TO ROLE VULN_DEPLOYER_${ENV};
GRANT USAGE, CREATE TABLE, CREATE VIEW, CREATE PROCEDURE, CREATE FUNCTION, CREATE SEQUENCE,
      CREATE STAGE, CREATE FILE FORMAT, CREATE STREAM, CREATE TASK
  ON SCHEMA VULN_MGMT_${ENV}.CURATED_VULN_MANAGEMENT TO ROLE VULN_DEPLOYER_${ENV};
GRANT USAGE, CREATE TABLE, CREATE VIEW, CREATE PROCEDURE, CREATE FUNCTION, CREATE SEQUENCE
  ON SCHEMA VULN_MGMT_${ENV}.BYOD_INFOSEC            TO ROLE VULN_DEPLOYER_${ENV};
GRANT USAGE, CREATE TABLE
  ON SCHEMA VULN_MGMT_${ENV}.SCHEMACHANGE            TO ROLE VULN_DEPLOYER_${ENV};
${DEPLOYER_EXTRA}

-- ---------- 5. Loader (ADF): write RAW, run CURATED procedures. No BYOD access. ----------
GRANT USAGE ON SCHEMA VULN_MGMT_${ENV}.RAW_VULN_MANAGEMENT TO ROLE VULN_LOADER_${ENV};
GRANT SELECT, INSERT ON FUTURE TABLES        IN SCHEMA VULN_MGMT_${ENV}.RAW_VULN_MANAGEMENT TO ROLE VULN_LOADER_${ENV};
GRANT USAGE          ON FUTURE STAGES        IN SCHEMA VULN_MGMT_${ENV}.RAW_VULN_MANAGEMENT TO ROLE VULN_LOADER_${ENV};
GRANT USAGE          ON FUTURE FILE FORMATS  IN SCHEMA VULN_MGMT_${ENV}.RAW_VULN_MANAGEMENT TO ROLE VULN_LOADER_${ENV};
GRANT USAGE ON SCHEMA VULN_MGMT_${ENV}.CURATED_VULN_MANAGEMENT TO ROLE VULN_LOADER_${ENV};
GRANT SELECT, INSERT, UPDATE, DELETE ON FUTURE TABLES IN SCHEMA VULN_MGMT_${ENV}.CURATED_VULN_MANAGEMENT TO ROLE VULN_LOADER_${ENV};
GRANT USAGE ON FUTURE PROCEDURES IN SCHEMA VULN_MGMT_${ENV}.CURATED_VULN_MANAGEMENT TO ROLE VULN_LOADER_${ENV};
GRANT USAGE ON FUTURE SEQUENCES  IN SCHEMA VULN_MGMT_${ENV}.CURATED_VULN_MANAGEMENT TO ROLE VULN_LOADER_${ENV};

-- ---------- 6. Reporter (Tableau): read the published contract only ----------
GRANT USAGE  ON SCHEMA VULN_MGMT_${ENV}.BYOD_INFOSEC TO ROLE VULN_REPORTER_${ENV};
GRANT SELECT ON FUTURE VIEWS  IN SCHEMA VULN_MGMT_${ENV}.BYOD_INFOSEC TO ROLE VULN_REPORTER_${ENV};
GRANT SELECT ON FUTURE TABLES IN SCHEMA VULN_MGMT_${ENV}.BYOD_INFOSEC TO ROLE VULN_REPORTER_${ENV};
GRANT SELECT ON ALL VIEWS     IN SCHEMA VULN_MGMT_${ENV}.BYOD_INFOSEC TO ROLE VULN_REPORTER_${ENV};
GRANT SELECT ON ALL TABLES    IN SCHEMA VULN_MGMT_${ENV}.BYOD_INFOSEC TO ROLE VULN_REPORTER_${ENV};

-- ---------- 7. Service users: key-pair only (TYPE = SERVICE cannot use passwords) ----------
USE ROLE USERADMIN;
CREATE USER IF NOT EXISTS SVC_VULN_DEPLOYER_${ENV} TYPE = SERVICE
  DEFAULT_ROLE = VULN_DEPLOYER_${ENV} DEFAULT_WAREHOUSE = VULN_WH DEFAULT_NAMESPACE = VULN_MGMT_${ENV}
  COMMENT = 'GitHub Actions / schemachange (${ENV})';
CREATE USER IF NOT EXISTS SVC_VULN_LOADER_${ENV} TYPE = SERVICE
  DEFAULT_ROLE = VULN_LOADER_${ENV} DEFAULT_WAREHOUSE = VULN_WH DEFAULT_NAMESPACE = VULN_MGMT_${ENV}
  COMMENT = 'Azure Data Factory (${ENV})';
CREATE USER IF NOT EXISTS SVC_VULN_REPORTER_${ENV} TYPE = SERVICE
  DEFAULT_ROLE = VULN_REPORTER_${ENV} DEFAULT_WAREHOUSE = VULN_WH DEFAULT_NAMESPACE = VULN_MGMT_${ENV}.BYOD_INFOSEC
  COMMENT = 'Tableau Cloud (${ENV})';

USE ROLE SECURITYADMIN;
GRANT ROLE VULN_DEPLOYER_${ENV} TO USER SVC_VULN_DEPLOYER_${ENV};
GRANT ROLE VULN_LOADER_${ENV}   TO USER SVC_VULN_LOADER_${ENV};
GRANT ROLE VULN_REPORTER_${ENV} TO USER SVC_VULN_REPORTER_${ENV};

-- Next: run the ALTER USER ... SET RSA_PUBLIC_KEY statements that keys.sh printed.

-- ---------- 8. Checks (each should return rows) ----------
SHOW SCHEMAS IN DATABASE VULN_MGMT_${ENV};
SHOW GRANTS TO ROLE VULN_DEPLOYER_${ENV};
SHOW FUTURE GRANTS IN SCHEMA VULN_MGMT_${ENV}.BYOD_INFOSEC;
